{
  "name": "school-skills",
  "version": "0.1.0",
  "description": "School.fun AI agent skills — mapped to site modules, not GMGN clones",
  "groups": [
    "research",
    "markets",
    "trade",
    "vault",
    "listing"
  ],
  "auth": {
    "wallet_login": {
      "id": "wallet_login",
      "provider": "privy",
      "flow": "init_poll",
      "cli": {
        "init": "school login --init",
        "poll": "school login --poll --session <sessionId>",
        "paper": "school login --paper",
        "status": "school status",
        "logout": "school logout"
      },
      "outputs": [
        "phase",
        "loginUrl",
        "sessionId",
        "mode",
        "auth",
        "has_jwt",
        "expires_at",
        "address"
      ],
      "never_expose": [
        "privy_token",
        "jwt",
        "private_key",
        "mnemonic"
      ],
      "notes": "OKX-style browser login; Agent shows loginUrl only; DEBUG --token is not product UX"
    }
  },
  "skills": [
    {
      "id": "alpha_radar",
      "group": "research",
      "title": "Alpha Radar",
      "description": "List tokens that entered the $1M+ pool on School.fun Alpha Research",
      "input": {
        "type": "object",
        "properties": {
          "min_mcap": {
            "type": "number",
            "default": 1000000
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "maximum": 50
          }
        }
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "symbol",
            "mcap",
            "alphaScore"
          ],
          "properties": {
            "symbol": {
              "type": "string"
            },
            "ca": {
              "type": "string"
            },
            "mcap": {
              "type": "number"
            },
            "alphaScore": {
              "type": "number",
              "description": "Alpha score from kuant radar tokens (GET /api/v1/radar/pool/meme item report.total; activity events also accept total|score|alphaScore). SkillCard and ToolCallResult only. Not a vault_list field."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "id": "alpha_transcript",
      "group": "research",
      "title": "Alpha Transcript",
      "description": "School.fun Alpha scorecard / transcript for one token",
      "input": {
        "type": "object",
        "oneOf": [
          {
            "required": [
              "ca"
            ]
          },
          {
            "required": [
              "name"
            ]
          }
        ],
        "properties": {
          "ca": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "ca": {
            "type": "string"
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "narrative": {
            "type": "string"
          },
          "social": {
            "type": "object",
            "description": "Optional; omit or null fields when no evidence",
            "properties": {
              "x_mentions_24h": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "narrative_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kol_handles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sentiment": {
                "enum": [
                  "bull",
                  "mixed",
                  "bear",
                  null
                ]
              }
            }
          },
          "alphaScore": {
            "type": "number",
            "description": "Same kuant Alpha score as alpha_radar; prefer alphaScore. Do not invent if radar/lookup miss."
          }
        }
      }
    },
    {
      "id": "token_security",
      "group": "research",
      "title": "Token Security",
      "description": "School.fun security flags for a contract",
      "input": {
        "type": "object",
        "required": [
          "ca"
        ],
        "properties": {
          "ca": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "renounced": {
            "type": "boolean"
          },
          "blacklist": {
            "type": "boolean"
          },
          "tax": {
            "type": "number"
          },
          "top10": {
            "type": "number",
            "description": "Top10 holder percent"
          }
        }
      }
    },
    {
      "id": "trade_quote",
      "group": "markets",
      "title": "Trade Quote",
      "description": "Read-only spot/perp quote from School.fun markets",
      "input": {
        "type": "object",
        "required": [
          "pair",
          "side",
          "size"
        ],
        "properties": {
          "pair": {
            "type": "string"
          },
          "side": {
            "enum": [
              "buy",
              "sell",
              "long",
              "short"
            ]
          },
          "size": {
            "type": "number"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "price": {
            "type": "number"
          },
          "fee": {
            "type": "number"
          },
          "est_fill": {
            "type": "number"
          }
        }
      },
      "confirm_before_live": true,
      "confirm_card": {
        "required_user_action": "explicit_confirm",
        "fields": [
          "pair",
          "side",
          "size",
          "price",
          "fee",
          "est_fill"
        ],
        "cancel_stops": true,
        "notes": "OKX Confirming: show preview from trade_quote; live sign only after user confirms"
      },
      "rules": {
        "read_only": true,
        "places_order": false,
        "login_required": false
      }
    },
    {
      "id": "trade_paper",
      "group": "trade",
      "title": "Paper Trade",
      "description": "Local simulated fill only; never signs or hits chain. Live requires Privy separately.",
      "input": {
        "type": "object",
        "required": [
          "pair",
          "side",
          "size"
        ],
        "properties": {
          "pair": {
            "type": "string"
          },
          "side": {
            "enum": [
              "buy",
              "sell",
              "long",
              "short"
            ]
          },
          "size": {
            "type": "number"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "paper"
          },
          "fill_price": {
            "type": "number"
          },
          "size": {
            "type": "number"
          },
          "pnl_sim": {
            "type": "number"
          }
        }
      }
    },
    {
      "id": "vault_list",
      "group": "vault",
      "title": "Vault List",
      "description": "Read-only public/isolated vault pools",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "pool": {
              "type": "string"
            },
            "apr": {
              "type": "number"
            },
            "tvl": {
              "type": "number"
            },
            "operator": {
              "type": "string"
            }
          }
        }
      }
    }
  ],
  "p1": [
    "spot_trade",
    "perp_trade",
    "vault_deposit",
    "listing_draft"
  ],
  "cli_status_fields": [
    "mode",
    "auth",
    "has_jwt",
    "expires_at",
    "last_call"
  ],
  "figma": "https://www.figma.com/design/UMd2PuvLvBmfvzLiUyCSmu/%E5%AD%A6%E4%B9%A0demo?node-id=69-2",
  "cli_status_deprecated": [
    "key"
  ],
  "repos": {
    "skills": "https://github.com/jacktou/school-skills",
    "cli": "https://github.com/jacktou/school-cli",
    "frontend_deeplink": "https://github.com/MoonPum/Building-Orderbook-DEX-Frontend-V2",
    "dex_backend": "https://github.com/MoonPum/Building-Orderbook-DEX-V2",
    "webapp_api": "https://github.com/MoonPum/ak47-webapp-api"
  }
}
